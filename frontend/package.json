{
  "name": "phonics-frontend",
  "version": "1.0.0",
  "scripts": {
    "dev": "dotenv -e ../.env -- next dev",
    "build": "dotenv -e ../.env -- next build",
    "start": "dotenv -e ../.env -- next start",
    "copy-vad-assets": "shx mkdir -p public && shx cp node_modules/@ricky0123/vad-web/dist/vad.worklet.bundle.min.js public/ && shx cp node_modules/@ricky0123/vad-web/dist/silero_vad_legacy.onnx public/ && shx cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm public/",
    "postinstall": "npm run copy-vad-assets"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@mui/material-nextjs": "^9.0.1",
    "@mui/x-date-pickers": "^9.3.0",
    "@ricky0123/vad-web": "^0.0.30",
    "date-fns": "^4.2.1",
    "lucide-react": "^1.16.0",
    "next": "^14.0.0",
    "next-intl": "^4.13.2",
    "onnxruntime-web": "^1.26.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.0.0",
    "shx": "^0.4.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.0.0"
  }
}
