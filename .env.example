# Required environment variables for docker-compose.yml
# Copy this file to .env and fill in values before running `docker compose up`

# PostgreSQL
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:Pass1234!@localhost:5432/phonics

# Backend port (local dev)
PORT=3000

# MinIO object storage
# MINIO_SECRET_KEY is used as both the MinIO root password and the backend S3 secret key
MINIO_SECRET_KEY=

# JWT signing secret — change this in production
JWT_SECRET=

# Backend seeding credentials
TEACHER_EMAIL=
TEACHER_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Azure Speech (required for phonics/speaking scoring)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Azure OpenAI (optional — semantic scoring for speaking homework)
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# BFA job queue (optional — defaults work for local dev)
# BFA_QUEUE_CONCURRENCY=1
# BFA_WEBHOOK_URL=

# Frontend subdomain detection
# Set to 'admin', 'app', or 'student' depending on which container this is.
# For multi-container deployments, run three frontend services with different values.
NEXT_PUBLIC_SUBDOMAIN=app

# Frontend origin URLs (used for CORS and redirects)
NEXT_PUBLIC_ADMIN_ORIGIN=https://admin.katie.vn
NEXT_PUBLIC_APP_ORIGIN=https://app.katie.vn
NEXT_PUBLIC_STUDENT_ORIGIN=https://student.katie.vn
NEXT_PUBLIC_LOGIN_URL=https://app.katie.vn/login
