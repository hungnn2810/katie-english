# Required environment variables for docker-compose.yml
# Copy this file to .env and fill in values before running `docker compose up`

# PostgreSQL
POSTGRES_PASSWORD=

# MinIO object storage
MINIO_ROOT_PASSWORD=
MINIO_SECRET_KEY=

# Backend seeding credentials
TEACHER_EMAIL=
TEACHER_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Azure Speech (optional — phonics scoring)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Frontend subdomain detection
# Set to 'admin', 'app', or 'student' depending on which container this is.
# For multi-container deployments, run three frontend services with different values.
NEXT_PUBLIC_SUBDOMAIN=app

# Frontend origin URLs (used for CORS and redirects)
NEXT_PUBLIC_ADMIN_ORIGIN=https://admin.katie.vn
NEXT_PUBLIC_APP_ORIGIN=https://app.katie.vn
NEXT_PUBLIC_STUDENT_ORIGIN=https://student.katie.vn
NEXT_PUBLIC_LOGIN_URL=https://app.katie.vn/login
