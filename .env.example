# Environment variables are now split by service:
#
#   backend/.env.example   — backend (NestJS): DB, MinIO, Redis, Azure, seeding
#   frontend/.env.example  — frontend (Next.js): NEXT_PUBLIC_* vars
#
# Copy each example to its real location and fill in values:
#
#   cp backend/.env.example  backend/.env
#   cp frontend/.env.example frontend/.env.local
#
# Docker Compose reads backend/.env and frontend/.env.local automatically
# via the env_file directive in docker-compose.yml.
