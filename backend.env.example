# =============================================================================
# Backend production secrets — copy to backend.env beside docker-compose.prod.yml
# DATABASE_URL, MINIO_ENDPOINT, REDIS_URL, PORT are overridden by compose
# =============================================================================

JWT_SECRET=change_me_at_least_64_chars_random_string

MINIO_PORT=9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=change_me_strong_minio_password
MINIO_BUCKET=phonics-audio
MINIO_USE_SSL=false

TEACHER_EMAIL=teacher@katie-english.com.vn
TEACHER_PASSWORD=change_me
ADMIN_EMAIL=admin@katie-english.com.vn
ADMIN_PASSWORD=change_me

ADMIN_ORIGIN=https://admin.katie-english.com.vn
TEACHER_ORIGIN=https://app.katie-english.com.vn
STUDENT_ORIGIN=https://student.katie-english.com.vn

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_PHONEME_CORRECT_THRESHOLD=80
AZURE_PHONEME_SIMILAR_THRESHOLD=50
AZURE_MIN_WORD_SCORE=70

AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

ZALO_OA_ACCESS_TOKEN=
ZALO_ZNS_TEMPLATE_ID=
