generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClassStatus {
  PENDING
  INPROGRESS
  ENDED
}

enum HomeworkType {
  PHONICS
  SPEAKING
  READING
  VOCABULARY
  LISTEN
}

enum ReadingActivityType {
  MATCH
  FILL_BLANK
}

enum SpeakingMode {
  FREE_SPEAK
  SCRIPT_MATCH
}

enum Sex {
  MALE
  FEMALE
}

enum ParentType {
  FATHER
  MOTHER
}

model Phoneme {
  id           Int           @id @default(autoincrement())
  symbol       String        @unique
  audioUrl     String
  type         String
  wordPhonemes WordPhoneme[]

  @@map("phonemes")
}

model Word {
  id           Int           @id @default(autoincrement())
  text         String        @unique
  audioUrl     String
  difficulty   Int           @default(1)
  phonemes     String?
  wordPhonemes WordPhoneme[]

  @@map("words")
}

model WordPhoneme {
  id         Int     @id @default(autoincrement())
  wordId     Int
  phonemeId  Int
  orderIndex Int
  word       Word    @relation(fields: [wordId], references: [id], onDelete: Cascade)
  phoneme    Phoneme @relation(fields: [phonemeId], references: [id], onDelete: Cascade)

  @@unique([wordId, orderIndex])
  @@map("word_phonemes")
}

model Class {
  id             Int                       @id @default(autoincrement())
  name           String
  code           String                    @unique
  startDate      DateTime
  endDate        DateTime
  status         ClassStatus               @default(PENDING)
  scheduleSlots  Json                      @default("[]")
  teacherId      Int?
  teacher        User?                     @relation("TeacherClasses", fields: [teacherId], references: [id])
  students       Student[]
  assignments    HomeworkAssignmentClass[]
  tuitionConfig  TuitionConfig?
  tuitionRecords TuitionRecord[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@map("classes")
}

model Student {
  id             Int               @id @default(autoincrement())
  fullname       String
  sex            Sex
  dateOfBirth    DateTime
  classId        Int?
  class          Class?            @relation(fields: [classId], references: [id])
  parents        ParentInfo[]
  sessions       HomeworkSession[]
  tuitionRecords TuitionRecord[]
  user           User?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("students")
}

model ParentInfo {
  id          Int        @id @default(autoincrement())
  name        String
  phoneNumber String
  type        ParentType
  studentId   Int
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("parent_infos")
}

model Homework {
  id                 Int                  @id @default(autoincrement())
  type               HomeworkType
  speakingMode       SpeakingMode?
  name               String?
  speakingPictureUrl String?
  speakingText       String?
  parts              HomeworkPart[]
  assignments        HomeworkAssignment[]
  readingActivities  ReadingActivity[]
  vocabItems         VocabItem[]          @relation("VocabItems")
  listenItems        ListenItem[]         @relation("ListenItems")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@map("homeworks")
}

model HomeworkPart {
  id         Int            @id @default(autoincrement())
  homeworkId Int
  name       String
  order      Int
  homework   Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  words      HomeworkWord[]

  @@unique([homeworkId, order])
  @@map("homework_parts")
}

model HomeworkWord {
  id             Int                 @id @default(autoincrement())
  partId         Int
  text           String
  highlight      String?
  imageUrl       String?
  order          Int
  part           HomeworkPart        @relation(fields: [partId], references: [id], onDelete: Cascade)
  phonicsResults PhonicsItemResult[]

  @@unique([partId, order])
  @@map("homework_words")
}

model HomeworkAssignment {
  id         Int                       @id @default(autoincrement())
  homeworkId Int
  endDate    DateTime
  homework   Homework                  @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  classes    HomeworkAssignmentClass[]
  sessions   HomeworkSession[]
  createdAt  DateTime                  @default(now())

  @@map("homework_assignments")
}

model HomeworkAssignmentClass {
  id           Int                @id @default(autoincrement())
  assignmentId Int
  classId      Int
  assignment   HomeworkAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  class        Class              @relation(fields: [classId], references: [id])

  @@unique([assignmentId, classId])
  @@map("homework_assignment_classes")
}

model HomeworkSession {
  id              Int                 @id @default(autoincrement())
  studentId       Int
  assignmentId    Int
  score           Float?
  completedAt     DateTime?
  startedAt       DateTime            @default(now())
  student         Student             @relation(fields: [studentId], references: [id])
  assignment      HomeworkAssignment  @relation(fields: [assignmentId], references: [id])
  speakingResults SpeakingResult[]
  phonicsResults  PhonicsItemResult[]
  readingResult   ReadingResult?
  listenResults   ListenItemResult[]

  @@map("homework_sessions")
}

model SpeakingResult {
  id              Int             @id @default(autoincrement())
  sessionId       Int             @unique
  transcribedText String?
  score           Float
  matchedWords    Int
  totalWords      Int
  phonemes        String?
  session         HomeworkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("speaking_results")
}

model PhonicsItemResult {
  id              Int             @id @default(autoincrement())
  sessionId       Int
  wordId          Int?
  vocabItemId     Int?
  transcribedText String?
  score           Float
  session         HomeworkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  word            HomeworkWord?   @relation(fields: [wordId], references: [id], onDelete: Cascade)
  vocabItem       VocabItem?      @relation(fields: [vocabItemId], references: [id], onDelete: Cascade)

  @@map("phonics_item_results")
}

model VocabItem {
  id             Int                 @id @default(autoincrement())
  homeworkId     Int
  homework       Homework            @relation("VocabItems", fields: [homeworkId], references: [id], onDelete: Cascade)
  imageUrl       String
  word           String
  phonemes       String?
  order          Int                 @default(0)
  createdAt      DateTime            @default(now())
  phonicsResults PhonicsItemResult[]

  @@index([homeworkId])
  @@map("vocab_items")
}

model ReadingActivity {
  id         Int                 @id @default(autoincrement())
  homeworkId Int
  type       ReadingActivityType
  order      Int
  homework   Homework            @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  matchPairs MatchPair[]
  fillBlanks FillBlank[]

  @@unique([homeworkId, order])
  @@map("reading_activities")
}

model MatchPair {
  id         Int             @id @default(autoincrement())
  activityId Int
  imageUrl   String
  word       String
  order      Int
  activity   ReadingActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, order])
  @@map("match_pairs")
}

model FillBlank {
  id         Int               @id @default(autoincrement())
  activityId Int
  sentence   String
  order      Int
  activity   ReadingActivity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  choices    FillBlankChoice[]

  @@unique([activityId, order])
  @@map("fill_blanks")
}

model FillBlankChoice {
  id        Int       @id @default(autoincrement())
  blankId   Int
  word      String
  isCorrect Boolean
  blank     FillBlank @relation(fields: [blankId], references: [id], onDelete: Cascade)

  @@map("fill_blank_choices")
}

model ReadingResult {
  id           Int             @id @default(autoincrement())
  sessionId    Int             @unique
  totalItems   Int
  correctItems Int
  score        Float
  session      HomeworkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("reading_results")
}

model ListenItem {
  id           Int                @id @default(autoincrement())
  homeworkId   Int
  homework     Homework           @relation("ListenItems", fields: [homeworkId], references: [id], onDelete: Cascade)
  audioUrl     String
  keywords     String             // JSON array of expected keywords e.g. ["red", "cat"]
  expectedText String             // full expected answer for semantic scoring
  order        Int                @default(0)
  createdAt    DateTime           @default(now())
  results      ListenItemResult[]

  @@index([homeworkId])
  @@map("listen_items")
}

model ListenItemResult {
  id             Int             @id @default(autoincrement())
  sessionId      Int
  listenItemId   Int
  itemOrder      Int             @default(0)
  transcript     String          @default("")
  semanticScore  Float           @default(0)
  pronScore      Float           @default(0)
  compositeScore Float           @default(0)
  bfaFeedback    String?         // JSON — BFA feedback for matched keywords
  session        HomeworkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  listenItem     ListenItem      @relation(fields: [listenItemId], references: [id], onDelete: Cascade)

  @@map("listen_item_results")
}

enum UserRole {
  TEACHER
  STUDENT
  ADMIN
}

model User {
  id                     Int      @id @default(autoincrement())
  upn                    String   @unique
  email                  String?  @unique
  name                   String?
  phone                  String?
  disabled               Boolean  @default(false)
  password               String
  role                   UserRole
  approved               Boolean  @default(false)
  studentId              Int?     @unique
  student                Student? @relation(fields: [studentId], references: [id])
  classes                Class[]  @relation("TeacherClasses")
  registrationData       Json?
  passwordResetRequested Boolean  @default(false)
  createdAt              DateTime @default(now())

  @@map("users")
}

enum TuitionStatus {
  PENDING
  PAID
  OVERDUE
}

model TuitionConfig {
  id              Int      @id @default(autoincrement())
  classId         Int      @unique
  class           Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  pricePerSession Int      // VNĐ per session
  bookFee         Int?     // nullable, VNĐ
  dueDayOfMonth   Int      // 1-31
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("tuition_configs")
}

model TuitionRecord {
  id               Int                      @id @default(autoincrement())
  studentId        Int
  student          Student                  @relation(fields: [studentId], references: [id])
  classId          Int
  class            Class                    @relation(fields: [classId], references: [id])
  month            Int                      // 1-12
  year             Int
  tuitionAmount    Int                      // VNĐ
  bookFee          Int                      // VNĐ (0 if not charged)
  totalAmount      Int                      // VNĐ
  dueDate          DateTime
  status           TuitionStatus            @default(PENDING)
  paidAt           DateTime?
  paidBy           String?                  // admin/teacher username or ID
  notificationLogs TuitionNotificationLog[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([studentId, classId, month, year])
  @@map("tuition_records")
}

model TuitionNotificationLog {
  id              Int           @id @default(autoincrement())
  tuitionRecordId Int
  tuitionRecord   TuitionRecord @relation(fields: [tuitionRecordId], references: [id], onDelete: Cascade)
  sentAt          DateTime
  zaloResponse    String        // JSON stringified Zalo API response
  success         Boolean
  createdAt       DateTime      @default(now())

  @@map("tuition_notification_logs")
}
