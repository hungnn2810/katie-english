generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClassStatus {
  PENDING
  INPROGRESS
  ENDED
}

enum HomeworkType {
  PHONICS
  SPEAKING
  READING
}

enum ReadingActivityType {
  MATCHING
  FILL_IN_BLANK
}

enum SpeakingMode {
  FREE_SPEAK
  SCRIPT_MATCH
}

enum Sex {
  MALE
  FEMALE
}

enum ParentType {
  FATHER
  MOTHER
}

model Phoneme {
  id           Int           @id @default(autoincrement())
  symbol       String        @unique
  audioUrl     String
  type         String
  wordPhonemes WordPhoneme[]

  @@map("phonemes")
}

model Word {
  id           Int           @id @default(autoincrement())
  text         String        @unique
  audioUrl     String
  difficulty   Int           @default(1)
  wordPhonemes WordPhoneme[]

  @@map("words")
}

model WordPhoneme {
  id         Int     @id @default(autoincrement())
  wordId     Int
  phonemeId  Int
  orderIndex Int
  word       Word    @relation(fields: [wordId], references: [id], onDelete: Cascade)
  phoneme    Phoneme @relation(fields: [phonemeId], references: [id], onDelete: Cascade)

  @@unique([wordId, orderIndex])
  @@map("word_phonemes")
}

model Class {
  id            Int                       @id @default(autoincrement())
  name          String
  code          String                    @unique
  startDate     DateTime
  endDate       DateTime
  status        ClassStatus               @default(PENDING)
  scheduleSlots Json                      @default("[]")
  students      Student[]
  assignments   HomeworkAssignmentClass[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@map("classes")
}

model Student {
  id          Int               @id @default(autoincrement())
  fullname    String
  sex         Sex
  dateOfBirth DateTime
  classId     Int?
  class       Class?            @relation(fields: [classId], references: [id])
  parents     ParentInfo[]
  sessions    HomeworkSession[]
  user        User?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("students")
}

model ParentInfo {
  id          Int        @id @default(autoincrement())
  name        String
  phoneNumber String
  type        ParentType
  studentId   Int
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("parent_infos")
}

model Homework {
  id                 Int                  @id @default(autoincrement())
  type               HomeworkType
  speakingMode       SpeakingMode?
  name               String?
  speakingPictureUrl String?
  speakingText       String?
  parts              HomeworkPart[]
  assignments        HomeworkAssignment[]
  readingActivities  ReadingActivity[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@map("homeworks")
}

model HomeworkPart {
  id         Int            @id @default(autoincrement())
  homeworkId Int
  name       String
  order      Int
  homework   Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  words      HomeworkWord[]

  @@unique([homeworkId, order])
  @@map("homework_parts")
}

model HomeworkWord {
  id             Int                 @id @default(autoincrement())
  partId         Int
  text           String
  highlight      String?
  imageUrl       String?
  order          Int
  part           HomeworkPart        @relation(fields: [partId], references: [id], onDelete: Cascade)
  phonicsResults PhonicsItemResult[]

  @@unique([partId, order])
  @@map("homework_words")
}

model HomeworkAssignment {
  id         Int                       @id @default(autoincrement())
  homeworkId Int
  endDate    DateTime
  homework   Homework                  @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  classes    HomeworkAssignmentClass[]
  sessions   HomeworkSession[]
  createdAt  DateTime                  @default(now())

  @@map("homework_assignments")
}

model HomeworkAssignmentClass {
  id           Int                @id @default(autoincrement())
  assignmentId Int
  classId      Int
  assignment   HomeworkAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  class        Class              @relation(fields: [classId], references: [id])

  @@unique([assignmentId, classId])
  @@map("homework_assignment_classes")
}

model HomeworkSession {
  id                     Int                     @id @default(autoincrement())
  studentId              Int
  assignmentId           Int
  videoUrl               String?
  score                  Float?
  completedAt            DateTime?
  startedAt              DateTime                @default(now())
  student                Student                 @relation(fields: [studentId], references: [id])
  assignment             HomeworkAssignment      @relation(fields: [assignmentId], references: [id])
  speakingResults        SpeakingResult[]
  phonicsResults         PhonicsItemResult[]
  readingActivityResults ReadingActivityResult[]

  @@map("homework_sessions")
}

model SpeakingResult {
  id              Int             @id @default(autoincrement())
  sessionId       Int             @unique
  transcribedText String?
  score           Float
  matchedWords    Int
  totalWords      Int
  session         HomeworkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("speaking_results")
}

model PhonicsItemResult {
  id              Int             @id @default(autoincrement())
  sessionId       Int
  wordId          Int
  transcribedText String?
  score           Float
  session         HomeworkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  word            HomeworkWord    @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([sessionId, wordId])
  @@map("phonics_item_results")
}

enum UserRole {
  TEACHER
  STUDENT
}

model User {
  id                     Int      @id @default(autoincrement())
  upn                    String   @unique
  password               String
  role                   UserRole
  approved               Boolean  @default(false)
  studentId              Int?     @unique
  student                Student? @relation(fields: [studentId], references: [id])
  registrationData       Json?
  passwordResetRequested Boolean  @default(false)
  createdAt              DateTime @default(now())

  @@map("users")
}

model ReadingActivity {
  id              Int                     @id @default(autoincrement())
  homeworkId      Int
  type            ReadingActivityType
  order           Int
  homework        Homework                @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  matchingPairs   MatchingPair[]
  fillInBlank     FillInBlankActivity?
  activityResults ReadingActivityResult[]

  @@unique([homeworkId, order])
  @@map("reading_activities")
}

model MatchingPair {
  id          Int                  @id @default(autoincrement())
  activityId  Int
  imageUrl    String
  word        String
  order       Int
  activity    ReadingActivity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  itemResults MatchingItemResult[]

  @@unique([activityId, order])
  @@map("matching_pairs")
}

model FillInBlankActivity {
  id               Int                @id @default(autoincrement())
  activityId       Int                @unique
  sentenceSegments Json
  activity         ReadingActivity    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  blanks           FillInBlankBlank[]

  @@map("fill_in_blank_activities")
}

model FillInBlankBlank {
  id          Int                     @id @default(autoincrement())
  activityId  Int
  blankIndex  Int
  correctWord String
  distractors Json
  fillInBlank FillInBlankActivity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  itemResults FillInBlankItemResult[]

  @@unique([activityId, blankIndex])
  @@map("fill_in_blank_blanks")
}

model ReadingActivityResult {
  id                 Int                     @id @default(autoincrement())
  sessionId          Int
  activityId         Int
  score              Float
  session            HomeworkSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  activity           ReadingActivity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  matchingResults    MatchingItemResult[]
  fillInBlankResults FillInBlankItemResult[]

  @@unique([sessionId, activityId])
  @@map("reading_activity_results")
}

model MatchingItemResult {
  id                Int                   @id @default(autoincrement())
  activityResultId  Int
  pairId            Int
  studentChosenWord String
  isCorrect         Boolean
  activityResult    ReadingActivityResult @relation(fields: [activityResultId], references: [id], onDelete: Cascade)
  pair              MatchingPair          @relation(fields: [pairId], references: [id], onDelete: Cascade)

  @@unique([activityResultId, pairId])
  @@map("matching_item_results")
}

model FillInBlankItemResult {
  id                Int                   @id @default(autoincrement())
  activityResultId  Int
  blankId           Int
  studentChosenWord String
  isCorrect         Boolean
  activityResult    ReadingActivityResult @relation(fields: [activityResultId], references: [id], onDelete: Cascade)
  blank             FillInBlankBlank      @relation(fields: [blankId], references: [id], onDelete: Cascade)

  @@unique([activityResultId, blankId])
  @@map("fill_in_blank_item_results")
}
