# =============================================================================
# Production environment — copy to .env beside docker-compose.prod.yml
# =============================================================================

# Docker Hub image registry
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest

# Database password (used by postgres service and DATABASE_URL override)
POSTGRES_PASSWORD=change_me_strong_password

# MinIO credentials (used by minio service and backend env)
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=change_me_strong_minio_password
