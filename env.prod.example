# =============================================================================
# Production environment — copy to .env beside docker-compose.prod.yml
# Fill in all values marked with <...> before deploying
# =============================================================================

# ── Docker / Image ────────────────────────────────────────────────────────────
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=<strong_random_password>
DATABASE_URL=postgresql://postgres:<strong_random_password>@postgres:5432/phonics

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=3001
JWT_SECRET=<at_least_64_random_chars>

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=<strong_random_password>
MINIO_BUCKET=phonics-audio
MINIO_USE_SSL=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Seeding ───────────────────────────────────────────────────────────────────
TEACHER_EMAIL=teacher@katie-english.com.vn
TEACHER_PASSWORD=<teacher_password>
ADMIN_EMAIL=admin@katie-english.com.vn
ADMIN_PASSWORD=<admin_password>

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=https://katie-english.com.vn

# ── Azure Speech (required for phonics/speaking scoring) ──────────────────────
AZURE_SPEECH_KEY=<azure_speech_key>
AZURE_SPEECH_REGION=eastus
AZURE_PHONEME_CORRECT_THRESHOLD=80
AZURE_PHONEME_SIMILAR_THRESHOLD=50
AZURE_MIN_WORD_SCORE=70

# ── Azure OpenAI (optional — semantic scoring for speaking homework) ───────────
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── Zalo ZNS (Zalo Notification Service for tuition notifications) ─────────────
ZALO_OA_ACCESS_TOKEN=
ZALO_ZNS_TEMPLATE_ID=
